<?xml version="1.0" encoding="utf-8"?>
<!--
  The meeting screen is owned by the SDK: MeshMeetingView brings its own video grid,
  meeting-code badge, timer, connection banner, participants panel, and control bar.

  The app keeps this layout as the seam where host-specific chrome can be layered on
  later (a branded header, a chat sheet, a recording indicator) without forking the SDK.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <dev.meshcall.sdk.ui.MeshMeetingView
        android:id="@+id/meeting_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
