<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000">

    <!-- Remote Video grid (populated by MeshCallRoomView) -->
    <FrameLayout
        android:id="@+id/call_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <dev.meshcall.sdk.ui.MeshVideoRenderer
            android:id="@+id/local_preview"
            android:layout_width="110dp"
            android:layout_height="160dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"/>
    </FrameLayout>

    <!-- Call chrome (top strip, does not overlap the top-right preview) -->
    <LinearLayout
        android:id="@+id/top_chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="132dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtRoomCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#66000000"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtCallTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#66000000"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Signaling connection banner -->
    <TextView
        android:id="@+id/banner_conn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:background="#C62828"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="@string/connecting_banner"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Participants overlay -->
    <LinearLayout
        android:id="@+id/panel_participants"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="140dp"
        android:background="#E6000000"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtParticipantsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/list_participants"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_participants"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/desc_participants"
            android:src="@android:drawable/ic_menu_agenda"
            android:tint="@android:color/white"
            app:borderWidth="0dp"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_mic"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="10dp"
            android:contentDescription="@string/desc_mic"
            android:src="@drawable/mic"
            android:tint="@android:color/white"
            app:borderWidth="0dp"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_end"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="10dp"
            android:contentDescription="@string/desc_end"
            android:src="@drawable/end"
            android:tint="@android:color/white"
            app:backgroundTint="#E53935"
            app:borderWidth="0dp"
            app:maxImageSize="28dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_camera"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="10dp"
            android:contentDescription="@string/desc_camera"
            android:src="@drawable/cam"
            android:tint="@android:color/white"
            app:borderWidth="0dp"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_switch_cam"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/desc_switch_cam"
            android:src="@android:drawable/ic_menu_camera"
            android:tint="@android:color/white"
            app:borderWidth="0dp"/>
    </LinearLayout>

</FrameLayout>
