<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="28dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!--
      Copy and Share leave this dialog open — you often want both, and one of them
      dismissing the code you were about to send is the whole problem. Closing is
      therefore explicit: this button, or Start.
    -->
    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="end"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close"
        app:tint="@color/on_surface_variant" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/your_meeting_code"
        android:textColor="@color/on_surface_variant"
        android:textSize="13sp"/>

    <TextView
        android:id="@+id/meeting_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.2"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/on_surface"
        android:textIsSelectable="true"
        android:textSize="34sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/share_meeting_hint"
        android:textColor="@color/on_surface_variant"
        android:textSize="13sp"/>

    <!-- Only for a private meeting: the code alone is not enough to get in. -->
    <TextView
        android:id="@+id/private_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="@string/private_meeting_code_notice"
        android:textColor="@color/on_surface"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_copy"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="14dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/surface_container_high"
                android:contentDescription="@string/copy"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_copy"
                app:tint="@color/on_surface"/>

            <TextView
                android:id="@+id/copy_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/copy"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_share"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="14dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/surface_container_high"
                android:contentDescription="@string/share"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_share"
                app:tint="@color/on_surface"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/share"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_start"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="14dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/surface_container_high"
                android:contentDescription="@string/start_meeting"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                app:tint="@color/on_surface"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/start_meeting"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
