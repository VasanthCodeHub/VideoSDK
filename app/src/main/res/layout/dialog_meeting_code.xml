<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/your_meeting_code"
        android:textColor="@color/on_surface_variant"
        android:textSize="13sp"/>

    <TextView
        android:id="@+id/meeting_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.2"
        android:textColor="@color/on_surface"
        android:textIsSelectable="true"
        android:textSize="34sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/share_meeting_hint"
        android:textColor="@color/on_surface_variant"
        android:textSize="13sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_copy"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/surface_container_high"
                android:contentDescription="@string/copy"
                android:scaleType="centerInside"
                android:src="@drawable/ic_copy"
                app:tint="@color/on_surface"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/copy"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_share"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/surface_container_high"
                android:contentDescription="@string/share"
                android:scaleType="centerInside"
                android:src="@drawable/ic_share"
                app:tint="@color/on_surface"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/share"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_start"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/primary"
                android:contentDescription="@string/start_meeting"
                android:scaleType="centerInside"
                android:src="@drawable/ic_play"
                app:tint="@color/on_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/start_meeting"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
