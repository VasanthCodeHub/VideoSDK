<?xml version="1.0" encoding="utf-8"?>
<!--
  The complete meeting screen, owned by the SDK.

  Order matters: the top bar comes first, the video grid takes the remaining space, and
  the control bar sits at the bottom. Chrome never overlaps the grid, so the SurfaceView
  tiles inside it are never covered (README §7 rule 6). The banner, participants panel,
  and overflow strip do float over the grid — they are ordinary views on the window
  plane, which always composites above an underlay surface.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/meshcall_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/meshcall_black"
    android:orientation="vertical">

    <!-- Top bar: meeting code, live timer, participants. Flip camera moved to the bar. -->
    <LinearLayout
        android:id="@+id/meshcall_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/meshcall_chrome_background"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/meshcall_desc_secured"
                android:src="@drawable/meshcall_ic_shield_lock" />

            <TextView
                android:id="@+id/meshcall_meeting_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/meshcall_on_chrome"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/meshcall_live_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/meshcall_bg_dot_pulse" />

            <TextView
                android:id="@+id/meshcall_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/meshcall_on_chrome"
                android:textSize="13sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/meshcall_btn_participants"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/meshcall_bg_icon_btn"
                android:contentDescription="@string/meshcall_desc_participants"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/meshcall_ic_groups" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/meshcall_chrome_divider" />
    </LinearLayout>

    <!-- Video grid + floating overlays -->
    <FrameLayout
        android:id="@+id/meshcall_grid_host"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/meshcall_grid_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <dev.meshcall.sdk.ui.MeshVideoRenderer
                android:id="@+id/meshcall_local_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView
            android:id="@+id/meshcall_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/meshcall_bg_banner"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="@string/meshcall_connecting_banner"
            android:textColor="@color/meshcall_white"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/meshcall_participants_panel"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/meshcall_bg_panel"
            android:maxHeight="320dp"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/meshcall_participants_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:textColor="@color/meshcall_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/meshcall_participants_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!--
          Private meetings: whoever is host sees this above everything, because a person
          stuck outside is waiting on exactly one tap. Only the host is ever sent knocks,
          so for everyone else it simply never appears.
        -->
        <LinearLayout
            android:id="@+id/meshcall_join_request_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="12dp"
            android:background="@drawable/meshcall_bg_panel"
            android:elevation="12dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/meshcall_request_avatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/meshcall_bg_avatar"
                    android:gravity="center"
                    android:textColor="@color/meshcall_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/meshcall_request_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/meshcall_white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/meshcall_request_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/meshcall_wants_to_join"
                        android:textColor="@color/meshcall_on_chrome_dim"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/meshcall_btn_decline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/meshcall_bg_sheet_action"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="@string/meshcall_decline"
                    android:textColor="@color/meshcall_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/meshcall_btn_admit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/meshcall_bg_sheet_action_primary"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="@string/meshcall_admit"
                    android:textColor="@color/meshcall_on_light"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/meshcall_request_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/meshcall_on_chrome_dim"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!--
          The glass pill lives on the strip itself, not on the scroll view: the grid
          toggles the strip's visibility, and a background on the scroll view would leave
          an empty floating pill behind whenever nobody is in overflow.
        -->
        <HorizontalScrollView
            android:id="@+id/meshcall_overflow_scroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:elevation="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/meshcall_overflow_strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/meshcall_bg_glass_bar"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="6dp"
                android:visibility="gone" />
        </HorizontalScrollView>

        <!--
          Private meeting, waiting on the host. Covers the grid rather than sitting beside
          it: nothing behind is worth looking at yet, and a live self-preview would read as
          "you're in". A sibling on the window plane, never a background on the renderer —
          see README §7 rule 6.
        -->
        <LinearLayout
            android:id="@+id/meshcall_waiting_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/meshcall_scrim"
            android:elevation="14dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/meshcall_waiting_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/meshcall_waiting_title"
                android:textColor="@color/meshcall_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meshcall_waiting_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/meshcall_waiting_message"
                android:textColor="@color/meshcall_on_chrome_dim"
                android:textSize="14sp" />

            <!--
              Only for the terminal states. While waiting there is nothing to acknowledge
              — the control bar's leave button is still the way out.
            -->
            <TextView
                android:id="@+id/meshcall_btn_overlay_leave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/meshcall_bg_sheet_action_primary"
                android:gravity="center"
                android:minWidth="160dp"
                android:paddingVertical="12dp"
                android:text="@string/meshcall_back_to_lobby"
                android:textColor="@color/meshcall_on_light"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- Control bar -->
    <LinearLayout
        android:id="@+id/meshcall_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/meshcall_bg_controls_bar"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp">

        <!--
          Six controls at 56dp would need 404dp of width and clip on a 360dp phone, so the
          bar runs at 48dp with 8dp gaps: 346dp, and the icons keep a 44dp+ touch target.
        -->
        <ImageButton
            android:id="@+id/meshcall_btn_mic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/meshcall_bg_control"
            android:contentDescription="@string/meshcall_desc_mic"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/meshcall_ic_mic" />

        <ImageButton
            android:id="@+id/meshcall_btn_camera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/meshcall_bg_control"
            android:contentDescription="@string/meshcall_desc_camera"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/meshcall_ic_videocam_on" />

        <!--
          Speaker, Bluetooth, wired and earpiece are one decision — which device the call
          is on — so they are one button that opens a picker, not four toggles that can
          contradict each other.
        -->
        <ImageButton
            android:id="@+id/meshcall_btn_audio_route"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/meshcall_bg_control"
            android:contentDescription="@string/meshcall_desc_audio_route"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/meshcall_ic_route_speaker" />

        <!--
          Flip camera sits with the other per-meeting media controls rather than in the
          top bar, next to the camera toggle it belongs with. The icon shows the lens
          that is currently live (front / rear), so the bar states which camera peers
          are seeing instead of only offering a flip.
        -->
        <ImageButton
            android:id="@+id/meshcall_btn_switch_camera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/meshcall_bg_control"
            android:contentDescription="@string/meshcall_desc_switch_camera"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/meshcall_ic_camera_front" />

        <!--
          Screen share is a first-class control, not a menu entry: it is a single toggle
          with a visible on/off state, which is exactly what the bar is for. The button
          turns active while sharing and stopping is one tap on the same button.
        -->
        <ImageButton
            android:id="@+id/meshcall_btn_share"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/meshcall_bg_control"
            android:contentDescription="@string/meshcall_desc_share"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/meshcall_ic_present_to_all" />

        <ImageButton
            android:id="@+id/meshcall_btn_leave"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/meshcall_bg_control_danger"
            android:contentDescription="@string/meshcall_desc_leave"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/meshcall_ic_call_end" />
    </LinearLayout>

</LinearLayout>
