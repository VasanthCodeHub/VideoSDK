<?xml version="1.0" encoding="utf-8"?>
<!-- The active route's row. Tinted rather than checked-only, so the current output is
     readable at a glance without hunting for a small tick. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <ripple android:color="#33FFFFFF" />
    </item>
</layer-list>
