<?xml version="1.0" encoding="utf-8"?>
<!--
  Rear camera in use: the device body with a single large lens knocked out of its centre.

  The stock Material glyph puts a 2dp lens near the top, which at the 22dp this actually
  renders at is all but identical to meshcall_ic_camera_front's head-and-shoulders — the
  two states were technically different and visually the same. The lens is deliberately
  oversized and centred so the pair reads apart at a glance.

  The lens is a *hole*, not a drawn circle: the body subpath fills solid, so a white circle
  painted over it would be invisible. fillType="evenOdd" makes the knockout independent of
  subpath winding direction, which is what the stock icon relied on.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
