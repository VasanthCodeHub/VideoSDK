<?xml version="1.0" encoding="utf-8"?>
<!--
  Stroke-only overlay drawn as the topmost child of every tile, on top of the video and
  chrome. clipToOutline on a SurfaceView is not reliably honored on every OEM/Android
  version, so the border is never left to chance by relying on bg_tile_frame alone —
  this always renders above the video, guaranteeing a crisp frame regardless.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1.5dp" android:color="#3DFFFFFF" />
    <corners android:radius="18dp" />
</shape>
