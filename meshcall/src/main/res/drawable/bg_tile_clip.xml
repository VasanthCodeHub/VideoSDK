<?xml version="1.0" encoding="utf-8"?>
<!--
  Set as the video renderer's own background so ViewOutlineProvider.BACKGROUND can derive
  a rounded clip shape from it — an outline is only generated from a *non-null* background,
  and without one clipToOutline silently does nothing, leaving the video's square corners
  overhanging bg_tile_frame's rounded border. Opaque and same radius/color as
  bg_tile_frame so any sliver visible before video attaches matches it exactly.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#18181B" />
    <corners android:radius="18dp" />
</shape>
