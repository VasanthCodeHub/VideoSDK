<?xml version="1.0" encoding="utf-8"?>
<!--
  The tile's own background, behind the video. It only shows through where there is no
  video yet; once a surface attaches, the rounded corners visible on screen are the ones
  TileFrameDrawable paints on top. Both read from the same two colors so they match.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/meshcall_tile_frame_bg" />
    <stroke android:width="1.5dp" android:color="@color/meshcall_tile_frame_stroke" />
    <corners android:radius="18dp" />
</shape>
